# ==============================================================================
# KONFIGURASI LINGKUNGAN APIWASPADA (PROTOTYPE KOTA JAMBI)
# Salin file ini menjadi .env sebelum menjalankan aplikasi di produksi/lokal:
#   copy .env.example .env   (Windows CMD/PowerShell)
# ==============================================================================

# --- Informasi Aplikasi ---
APP_NAME="ApiWaspada - Sistem Cerdas Deteksi Visual Api dan Asap Kota Jambi"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=true
HOST="127.0.0.1"
PORT=8000

# --- Keamanan & Autentikasi Petugas ---
# Ganti SECRET_KEY dengan string acak minimal 32 karakter pada penggunaan nyata
SECRET_KEY="ganti-dengan-secret-key-acak-minimal-32-karakter-apiwaspada-jambi"
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEFAULT_ADMIN_USERNAME="petugas_jambi"
# Password default hanya digunakan oleh scripts/init_admin.py saat inisialisasi awal jika belum diset
DEFAULT_ADMIN_PASSWORD="ApiWaspadaJambi2026!"
DEFAULT_ADMIN_FULLNAME="Petugas Piket Verifikasi Kota Jambi"

# --- CORS (Cross-Origin Resource Sharing) ---
ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500"

# --- Database SQLite ---
DATABASE_URL="sqlite:///./storage/database/apiwaspada.db"

# --- Penyimpanan File & Batas Upload ---
UPLOAD_DIR="storage/uploads"
RESULT_DIR="storage/results"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS="jpg,jpeg,png"

# --- Konfigurasi Model AI YOLO (D-Fire Dataset) ---
YOLO_MODEL_PATH="ml/weights/best.pt"
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_IMAGE_SIZE=640
YOLO_DEVICE="auto"
# Pemetaan kelas default D-Fire Dataset (0: smoke, 1: fire).
# Dapat disesuaikan jika data.yaml dari hasil training memiliki urutan berbeda.
YOLO_CLASS_MAP="0:smoke,1:fire"

# --- Konfigurasi Geografis Default (Kota Jambi, Provinsi Jambi) ---
DEFAULT_MAP_LAT=-1.6101
DEFAULT_MAP_LNG=103.6131
DEFAULT_MAP_ZOOM=12
# Batas koordinat wilayah Kota Jambi & sekitarnya (untuk peringatan cakupan wilayah)
JAMBI_BOUNDS_MIN_LAT=-1.8500
JAMBI_BOUNDS_MAX_LAT=-1.4000
JAMBI_BOUNDS_MIN_LNG=103.4000
JAMBI_BOUNDS_MAX_LNG=103.8500
